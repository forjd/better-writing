{
  "name": "quarterly-report",
  "brief": "Rewrite this report paragraph so it is specific and direct. Do not invent figures; the churn numbers are not available.",
  "required": [
    "second",
    "quarter",
    "March pricing change",
    "onboarding"
  ],
  "banned": [
    "important to note",
    "significant challenge",
    "competitive landscape",
    "observers",
    "crucial",
    "moving forward",
    "underscore",
    "proactive",
    "implications are significant",
    "next step"
  ],
  "banned_regex": [
    "\\d+(\\.\\d+)?\\s*%",
    "\\d[\\d,]*\\+?\\s*(users|teams|customers|companies|clients|members)"
  ],
  "max_words_ratio": 1.1
}
